{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ComfyNode Sentinel",
  "version": "0.3.0",
  "identifier": "com.comfynode.sentinel",
  "build": {
    "frontendDist": "loading",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "node scripts/prepare-desktop.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "ComfyNode Sentinel",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "resources": [
      "standalone-server/**/*"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {},
      "rpm": {}
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/vader431/ComfyNode-Sentinel/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
