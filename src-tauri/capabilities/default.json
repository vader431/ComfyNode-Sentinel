{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "local": true,
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://127.0.0.1:*/*",
      "http://localhost:*",
      "http://localhost:*/*"
    ]
  },
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "process:default",
    "updater:default",
    "allow-check-environment",
    "allow-toggle-node-state",
    "allow-quarantine-node-to-trash",
    "allow-scan-custom-nodes",
    "allow-set-minimize-to-tray",
    "allow-sync-tray-status",
    "allow-get-desktop-runtime-info",
    "allow-pick-directory",
    "allow-pick-file"
  ]
}
